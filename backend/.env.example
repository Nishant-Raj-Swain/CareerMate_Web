# Copy this file to .env and fill in real values before running the server.

# Port the API listens on
PORT=4000

# Long, random secret used to sign login tokens. Generate one with:
# python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=replace_this_with_a_long_random_string

# The origin your frontend is served from (used for CORS + cookies).
CLIENT_ORIGIN=http://localhost:5500

# development | production
FLASK_ENV=development

# Optional overrides for the login cookie. Leave unset to use sensible
# defaults (secure+SameSite=Lax in dev, secure+SameSite=None in production —
# the latter is required when the frontend and backend are on different
# domains, e.g. two separate Render services).
# COOKIE_SECURE=true
# COOKIE_SAMESITE=None
